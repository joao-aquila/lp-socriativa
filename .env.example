# URL canonica do site (usada em metadata, sitemap e robots)
NEXT_PUBLIC_SITE_URL=https://socriativa.com.br

# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo usado para assinar o cookie de sessao do admin
ADMIN_SESSION_SECRET=gere-uma-string-aleatoria-longa

# Publicacao do portfolio. Sem estas variaveis o painel escreve direto no
# repositorio local (comportamento usado em desenvolvimento).
# Token: GitHub > Settings > Developer settings > Personal access tokens >
# Fine-grained. Escopo: apenas este repositorio, permissao "Contents: Read and write".
GITHUB_TOKEN=
GITHUB_REPO=joao-aquila/lp-socriativa
GITHUB_BRANCH=main

# Opcional: token do Google Search Console (meta tag de verificacao)
GOOGLE_SITE_VERIFICATION=
