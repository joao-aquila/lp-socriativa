# URL canonica do site (usada em metadata, sitemap e robots).
# Entra no build: configure também nas variáveis de build do Workers Builds.
NEXT_PUBLIC_SITE_URL=https://socriativaestudio.com.br

# Opcional: token do Google Search Console (meta tag de verificacao)
GOOGLE_SITE_VERIFICATION=

# Bindings (D1, R2) e vars do Worker ficam em wrangler.jsonc; os overrides
# locais ficam em .dev.vars (copie de .dev.vars.example).
