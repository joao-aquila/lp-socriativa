{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "socriativa",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // *.workers.dev e as URLs de preview não passam pelo Cloudflare Access:
  // o site só responde pelo domínio próprio.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "socriativaestudio.com.br", "custom_domain": true },
    // os demais redirecionam para o principal (worker.ts)
    { "pattern": "www.socriativaestudio.com.br", "custom_domain": true },
    { "pattern": "socriativaestudio.com", "custom_domain": true },
    { "pattern": "www.socriativaestudio.com", "custom_domain": true }
  ],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "socriativa"
    }
  ],

  // projetos do portfólio (SQLite gerenciado)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
      // saída de `npx wrangler d1 create portfolio-db`
      "database_id": "947d2a80-bca6-4789-98da-6bf24b834bde",
      "migrations_dir": "migrations"
    }
  ],

  // artes do portfólio, servidas por img.socriativaestudio.com.br
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "portfolio-images"
    }
  ],

  // otimização do next/image (Cloudflare Images)
  "images": {
    "binding": "IMAGES"
  },

  // formulário de contato (Email Routing): o destino precisa estar verificado
  // em Email > Email Routing > Destination addresses
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "am.mellomantovani@gmail.com",
      "allowed_sender_addresses": ["site@socriativaestudio.com.br"]
    }
  ],

  "vars": {
    // domínio próprio do bucket R2; vazio => imagens servidas por /media/*
    "IMAGES_BASE_URL": "https://img.socriativaestudio.com.br",
    // Zero Trust > Settings > Custom Pages: https://<time>.cloudflareaccess.com
    "CF_ACCESS_TEAM_DOMAIN": "https://little-field-cb15.cloudflareaccess.com",
    // Zero Trust > Access > Applications > (app do /admin) > Application Audience (AUD) Tag
    "CF_ACCESS_AUD": "f55cf01199f5285b67a9006244def5d4500292f36100a1d6ea827652294398a5"
    // ADMIN_EMAILS (e-mails separados por vírgula, reforça a policy do Access)
    // é secret, fora do repositório: `npx wrangler secret put ADMIN_EMAILS`
  },

  "observability": { "enabled": true }
}
